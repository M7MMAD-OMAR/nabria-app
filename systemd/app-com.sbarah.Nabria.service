[Unit]
# Autostart. A .desktop file in ~/.config/autostart would be the obvious
# choice, but several Wayland compositors -- Hyprland among them -- do not read
# XDG autostart at all, and a unit works everywhere systemd does.
#
# The file name is not cosmetic. xdg-desktop-portal identifies a host
# application by its systemd unit, following the app-<app-id>-<...> convention,
# and the GlobalShortcuts portal refuses to bind anything for a caller it
# cannot name. Measured: running the same binary under a scope called
# app-com.sbarah.Nabria-probe.scope bound both shortcuts, while the identical
# run under nabria-control-probe.scope was refused with "An app id is
# required". Renaming this file breaks the portal shortcuts.
Description=Nabria voice dictation
Documentation=https://github.com/M7MMAD-OMAR/nabria-app
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# @RUN_SH@ is replaced by scripts/install.sh with the real path of this
# checkout. It used to be written out literally, which meant the unit only
# ever worked on the machine it was written on.
ExecStart=@RUN_SH@ daemon
# SIGTERM is handled inside the daemon, which stops the whisper server and
# releases its VRAM before exiting.
KillSignal=SIGTERM
Restart=on-failure
RestartSec=3
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
