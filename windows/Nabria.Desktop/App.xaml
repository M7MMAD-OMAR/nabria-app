<Application x:Class="Nabria.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="MinHeight" Value="38"/></Style>
   <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,6,0,14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
   <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,6,0,14"/></Style>
   <Style x:Key="NavigationItem" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
    <Setter Property="Margin" Value="0,3"/>
    <Setter Property="Padding" Value="12,14"/>
    <Setter Property="Template"><Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Surface" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Stretch"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="1"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
