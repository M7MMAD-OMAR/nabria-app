# The whisper.cpp release the engine is built from. Single source of truth:
# scripts/build-engine.sh, scripts/release-engine.sh and scripts/install.sh all
# read this file. Keeping it in three places is how a checksum mismatch starts
# looking like a corrupt download.
WHISPER_CPP_VERSION=v1.9.3

# The GitHub release holding the prebuilt engine. Derived, not written out:
# stated independently, bumping WHISPER_CPP_VERSION and forgetting this one
# would make the installer fetch the previous release, verify it against a
# checksum that still matched, pass the smoke test, and install an engine built
# from a tag the repository does not claim. Every guard would have passed.
#
# Bump ENGINE_REVISION when republishing the same upstream version.
ENGINE_REVISION=1
ENGINE_RELEASE=engine-$WHISPER_CPP_VERSION-$ENGINE_REVISION

# Vulkan headers used for the prebuilt build. Debian bookworm -- the oldest
# image that still packages the shader compiler, and so the oldest glibc we can
# offer -- ships 1.3.239, which predates VkLayerSettingEXT and will not compile
# whisper.cpp's Vulkan backend. Headers are compile-time only and the runtime
# ABI is stable, so a newer set is installed over the top rather than giving up
# the older glibc floor and with it every Debian 12 user.
VULKAN_HEADERS_VERSION=v1.3.290
